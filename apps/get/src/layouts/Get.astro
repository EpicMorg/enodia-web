---
import YandexMetrika from '../components/YandexMetrika.astro';
import { locales, localeByPath, localeHref, type LocalePath } from '../i18n/locales';

interface Props {
	locale: LocalePath;
	title: string;
	description: string;
}

const { locale, title, description } = Astro.props;
const site = 'https://get.enodia.sh';
---

<!doctype html>
<html lang={localeByPath(locale).lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" type="image/x-icon" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={`${site}${localeHref(locale)}`} />
		{locales.map((l) => <link rel="alternate" hreflang={l.lang} href={`${site}${localeHref(l.path)}`} />)}
		<link rel="alternate" hreflang="x-default" href={`${site}/`} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={`${site}/og-image.png`} />
		<meta name="twitter:card" content="summary_large_image" />
		<YandexMetrika />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: light dark;
		--bg: #ffffff;
		--fg: #1a1a1a;
		--muted: #666666;
		--border: #e2e2e2;
		--code-bg: #f5f5f5;
		--accent: #0f5f4f;
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #14161a;
			--fg: #eaeaea;
			--muted: #9a9a9a;
			--border: #2a2d33;
			--code-bg: #1d2024;
			--accent: #5fd0b3;
		}
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--fg);
		font-family:
			-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		line-height: 1.5;
	}

	main {
		max-width: 640px;
		margin: 0 auto;
		padding: 4rem 1.5rem 3rem;
	}

	.logo {
		display: block;
		width: 72px;
		height: 72px;
		margin-bottom: 1.25rem;
	}

	h1 {
		font-size: 1.7rem;
		margin: 0 0 0.5rem;
	}

	.tagline {
		color: var(--muted);
		font-size: 1.1rem;
		margin: 0 0 1.5rem;
	}

	.cmd {
		margin: 0 0 1.2rem;
	}

	/* Two alternative commands in one panel, split by a thin rule with a
	   localized "or" on it - same look as the landing page's Windows tab. */
	.alt {
		background: var(--code-bg);
		border: 1px solid var(--border);
		border-radius: 6px;
		overflow: hidden;
	}

	.alt pre {
		border: none;
		border-radius: 0;
	}

	.or {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0 1rem;
		color: var(--muted);
		font-size: 0.8rem;
	}

	.or::before,
	.or::after {
		content: '';
		flex: 1;
		border-top: 1px solid var(--border);
	}

	.cmd p {
		margin: 0 0 0.3rem;
		font-size: 0.85rem;
		color: var(--muted);
	}

	pre {
		background: var(--code-bg);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.9rem 1rem;
		overflow-x: auto;
		font-size: 0.9rem;
		margin: 0;
	}

	code {
		font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
	}

	.links a {
		white-space: nowrap;
	}

	a {
		color: var(--accent);
	}

	footer {
		max-width: 640px;
		margin: 0 auto;
		padding: 0 1.5rem 3rem;
		color: var(--muted);
		font-size: 0.85rem;
	}
</style>
